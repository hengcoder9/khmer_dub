{
  "name": "khmerdub-studio",
  "productName": "KhmerDub Studio",
  "version": "0.2.3",
  "description": "AI video dubbing studio (Khmer and more)",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "start": "node out/main/server.js",
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:ytdlp": "node scripts/fetch-ytdlp.mjs",
    "i18n": "node scripts/i18n-build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "fetch:assets": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-ytdlp.mjs && node scripts/fetch-fonts.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.3.7",
    "electron-updater": "^6.8.11",
    "fastify": "^5.1.0",
    "mysql2": "^3.24.6",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.460.0",
    "p-queue": "^8.1.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "zustand": "^5.0.1"
  }
}
